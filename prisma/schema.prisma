generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SALON_OWNER
  MANAGER
  RECEPTIONIST
  STAFF
}

enum InvitationStatus {
  DRAFT
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum SalonStatus {
  ACTIVE
  SUSPENDED
}

// Platform review of a salon's application. Unapproved salons can be set up
// by their owner but are hidden from the public.
enum SalonReview {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String             @id @db.Uuid
  email           String             @unique
  name            String?
  isSuperAdmin    Boolean            @default(false)
  lastLoginAt     DateTime?
  platformActions PlatformAuditLog[]
  feedback        Feedback[]
  payments        SalonPayment[]
  notices         PlatformNotice[]
  createdAt       DateTime           @default(now())
  memberships     SalonMember[]
}

model Salon {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  description     String?
  phone           String
  email           String?
  instagram       String?
  facebook        String?
  serviceTypes    String[]           @default([])
  staffCount      Int?
  logoUrl         String?
  coverUrl        String?
  status          SalonStatus        @default(ACTIVE)
  // Onboarding always writes PENDING; the default only covers older salons.
  reviewStatus    SalonReview        @default(APPROVED)
  reviewNote      String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  // Billing: a trial from approval, then paid 30-day periods. Access lasts
  // until the later of the two; both empty means the salon is not billed.
  trialEndsAt     DateTime?
  paidUntil       DateTime?
  // A fee the operator set for this salon; empty uses the per-branch price.
  monthlyPriceMnt Int?
  // The owner's answer as the trial ends; empty until asked.
  renewalChoice   RenewalChoice?
  renewalChosenAt DateTime?          @db.Timestamptz(3)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  members         SalonMember[]
  branches        Branch[]
  invitations     Invitation[]
  staff           Staff[]
  categories      ServiceCategory[]
  services        Service[]
  bookings        Booking[]
  notifications   Notification[]
  images          SalonImage[]
  branchImages    BranchImage[]
  platformAudit   PlatformAuditLog[]
  activity        BookingActivity[]
  reviews         Review[]
  bookingSettings BookingSettings?
  customers       Customer[]
  products        Product[]
  feedback        Feedback[]
  payments        SalonPayment[]
  checkouts       BillingCheckout[]

  @@index([createdAt])
  @@index([reviewStatus, submittedAt])
}

model SalonMember {
  id                String            @id @default(cuid())
  salonId           String
  userId            String            @db.Uuid
  role              Role
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now())
  salon             Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  branches          MemberBranch[]
  staff             Staff?
  bookings          Booking[]         @relation("BookingCreatedBy")
  cancelledBookings Booking[]         @relation("BookingCancelledBy")
  attendanceMarks   StaffAttendance[]

  // Last time this member opened the activity bell.
  activitySeenAt DateTime?
  // Last time this member dismissed the platform's announcements.
  noticeSeenAt   DateTime?

  @@unique([salonId, userId])
  @@unique([id, salonId])
  @@index([userId, active])
}

model Branch {
  id           String             @id @default(cuid())
  salonId      String
  name         String
  district     String
  address      String
  phone        String
  latitude     Float?
  longitude    Float?
  // Opening hours in minutes after local midnight; staff shifts default to these.
  openMinute   Int                @default(600)
  closeMinute  Int                @default(1140)
  // The branch's main photo (the first of `images`), shown at the top of the
  // booking page and in link previews.
  imageUrl     String?
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  salon        Salon              @relation(fields: [salonId], references: [id], onDelete: Cascade)
  members      MemberBranch[]
  invitations  InvitationBranch[]
  services     ServiceBranch[]
  staff        StaffBranch[]
  bookings     Booking[]
  productStock ProductStock[]
  // Photo gallery; the first photo is the main one and imageUrl mirrors it.
  images       BranchImage[]

  activity BookingActivity[]

  @@unique([id, salonId])
  @@index([salonId, active])
  @@index([district])
}

model MemberBranch {
  memberId String
  branchId String
  salonId  String
  member   SalonMember @relation(fields: [memberId, salonId], references: [id, salonId], onDelete: Cascade)
  branch   Branch      @relation(fields: [branchId, salonId], references: [id, salonId], onDelete: Cascade)

  @@id([memberId, branchId])
}

model Invitation {
  id         String             @id @default(cuid())
  salonId    String
  name       String
  email      String
  role       Role
  status     InvitationStatus   @default(PENDING)
  tokenHash  String             @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime           @default(now())
  salon      Salon              @relation(fields: [salonId], references: [id], onDelete: Cascade)
  branches   InvitationBranch[]

  @@unique([id, salonId])
  @@index([salonId, email])
}

model InvitationBranch {
  invitationId String
  branchId     String
  salonId      String
  invitation   Invitation @relation(fields: [invitationId, salonId], references: [id, salonId], onDelete: Cascade)
  branch       Branch     @relation(fields: [branchId, salonId], references: [id, salonId], onDelete: Cascade)

  @@id([invitationId, branchId])
}

model ServiceCategory {
  id        String    @id @default(cuid())
  salonId   String
  name      String
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  salon     Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services  Service[]

  @@unique([id, salonId])
  @@unique([salonId, name])
}

model Service {
  id              String          @id @default(cuid())
  salonId         String
  categoryId      String
  name            String
  description     String?
  priceMnt        Int
  durationMinutes Int
  discountPercent Int             @default(0)
  onlineBookable  Boolean         @default(false)
  active          Boolean         @default(true)
  imageUrl        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  salon           Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  category        ServiceCategory @relation(fields: [categoryId, salonId], references: [id, salonId])
  branches        ServiceBranch[]
  staff           StaffService[]
  bookings        Booking[]

  @@unique([id, salonId])
  @@index([salonId, active])
}

model ServiceBranch {
  serviceId String
  branchId  String
  salonId   String
  service   Service @relation(fields: [serviceId, salonId], references: [id, salonId], onDelete: Cascade)
  branch    Branch  @relation(fields: [branchId, salonId], references: [id, salonId], onDelete: Cascade)

  @@id([serviceId, branchId])
  @@unique([serviceId, branchId, salonId])
}

model Staff {
  id         String            @id @default(cuid())
  salonId    String
  memberId   String?
  name       String
  title      String
  phone      String?
  bio        String?
  // Shown to guests on the booking page; bio stays internal.
  about      String?
  imageUrl   String?
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  salon      Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  member     SalonMember?      @relation(fields: [memberId, salonId], references: [id, salonId])
  branches   StaffBranch[]
  services   StaffService[]
  bookings   Booking[]
  attendance StaffAttendance[]

  @@unique([id, salonId])
  @@unique([memberId, salonId])
  @@index([salonId, active])
}

model StaffBranch {
  staffId  String
  branchId String
  salonId  String
  staff    Staff          @relation(fields: [staffId, salonId], references: [id, salonId], onDelete: Cascade)
  branch   Branch         @relation(fields: [branchId, salonId], references: [id, salonId], onDelete: Cascade)
  hours    WorkingHours[]
  timeOff  TimeOff[]

  @@id([staffId, branchId])
  @@unique([staffId, branchId, salonId])
}

model StaffService {
  staffId   String
  serviceId String
  salonId   String
  staff     Staff   @relation(fields: [staffId, salonId], references: [id, salonId], onDelete: Cascade)
  service   Service @relation(fields: [serviceId, salonId], references: [id, salonId], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model WorkingHours {
  id          String         @id @default(cuid())
  salonId     String
  staffId     String
  branchId    String
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  active      Boolean        @default(true)
  assignment  StaffBranch    @relation(fields: [staffId, branchId, salonId], references: [staffId, branchId, salonId], onDelete: Restrict)
  breaks      WorkingBreak[]

  @@unique([id, salonId])
  @@index([salonId, branchId, staffId])
}

model WorkingBreak {
  id             String       @id @default(cuid())
  salonId        String
  workingHoursId String
  startMinute    Int
  endMinute      Int
  hours          WorkingHours @relation(fields: [workingHoursId, salonId], references: [id, salonId], onDelete: Cascade)

  @@index([salonId])
  // Loading the breaks of each working-hours row (schedules, staff pages).
  @@index([workingHoursId, salonId])
}

model TimeOff {
  id         String      @id @default(cuid())
  salonId    String
  staffId    String
  branchId   String
  startsAt   DateTime
  endsAt     DateTime
  fullDay    Boolean     @default(false)
  reason     String?
  assignment StaffBranch @relation(fields: [staffId, branchId, salonId], references: [staffId, branchId, salonId], onDelete: Restrict)

  @@index([salonId, branchId, staffId, startsAt])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  ONLINE
  RECEPTION
  OWNER
}

model Customer {
  id        String    @id @default(cuid())
  salonId   String
  name      String
  phone     String
  email     String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  salon     Salon     @relation(fields: [salonId], references: [id], onDelete: Restrict)
  bookings  Booking[]

  @@unique([id, salonId])
  @@unique([salonId, phone])
  @@index([salonId, name])
}

model Booking {
  id                      String            @id @default(cuid())
  salonId                 String
  branchId                String
  customerId              String
  serviceId               String
  staffId                 String
  startAt                 DateTime          @db.Timestamptz(3)
  endAt                   DateTime          @db.Timestamptz(3)
  status                  BookingStatus     @default(CONFIRMED)
  source                  BookingSource
  serviceNameSnapshot     String
  durationMinutesSnapshot Int
  priceSnapshot           Int
  discountPercentSnapshot Int               @default(0)
  depositAmountSnapshot   Int               @default(0)
  // Shared by bookings made together in one visit (parallel services).
  groupId                 String?
  // SHA-256 of the guest's manage-link token (shared within a visit).
  manageTokenHash         String?
  notifications           Notification[]
  activity                BookingActivity[]
  review                  Review?
  customerNameSnapshot    String
  customerPhoneSnapshot   String
  notes                   String?
  createdByMemberId       String?
  idempotencyKey          String
  requestHash             String
  version                 Int               @default(1)
  // The customer wants this staff member only; the booking stays with them.
  staffLocked             Boolean           @default(false)
  // Added at the desk on top of the service price, e.g. extra nail art.
  extraMnt                Int               @default(0)
  paymentMethod           PaymentMethod?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  salon                   Salon             @relation(fields: [salonId], references: [id], onDelete: Restrict)
  branch                  Branch            @relation(fields: [branchId, salonId], references: [id, salonId], onDelete: Restrict)
  customer                Customer          @relation(fields: [customerId, salonId], references: [id, salonId], onDelete: Restrict)
  service                 Service           @relation(fields: [serviceId, salonId], references: [id, salonId], onDelete: Restrict)
  staff                   Staff             @relation(fields: [staffId, salonId], references: [id, salonId], onDelete: Restrict)
  createdBy               SalonMember?      @relation("BookingCreatedBy", fields: [createdByMemberId, salonId], references: [id, salonId], onDelete: Restrict)
  // Who cancelled it: a team member, the customer, or the pending expiry.
  cancelledAt             DateTime?
  cancelSource            CancelSource?
  cancelledByMemberId     String?
  cancelledBy             SalonMember?      @relation("BookingCancelledBy", fields: [cancelledByMemberId, salonId], references: [id, salonId], onDelete: Restrict)

  @@unique([id, salonId])
  @@unique([salonId, idempotencyKey])
  // The owner's all-branch calendar filters by salon and time only.
  @@index([salonId, startAt])
  @@index([salonId, branchId, startAt])
  @@index([salonId, staffId, startAt])
  @@index([salonId, customerId, startAt])
  @@index([salonId, status, startAt])
  @@index([salonId, groupId])
  @@index([source, createdAt])
  @@index([manageTokenHash])
}

enum StaffHoursMode {
  CUSTOM
  SALON_HOURS
}

enum AttendanceStatus {
  WORKED
  OFF
}

model StaffAttendance {
  salonId           String
  staffId           String
  date              DateTime         @db.Date
  status            AttendanceStatus
  updatedByMemberId String?
  updatedAt         DateTime         @default(now()) @updatedAt
  staff             Staff            @relation(fields: [staffId, salonId], references: [id, salonId], onDelete: Cascade)
  updatedBy         SalonMember?     @relation(fields: [updatedByMemberId, salonId], references: [id, salonId], onDelete: Restrict)

  @@id([staffId, date])
  @@index([salonId, date])
}

enum DepositType {
  PERCENT
  FIXED
}

enum BookingConfirmationMode {
  AUTO_CONFIRM
  MANUAL_CONFIRM
}

// Colour palettes of the booking page; the layout is the same for all.
enum BookingTheme {
  CLASSIC
  GREEN
  ROSE
  VIOLET
  BLUE
}

model BookingSettings {
  bookingTheme                BookingTheme            @default(CLASSIC)
  salonId                     String                  @id
  publicBookingEnabled        Boolean                 @default(true)
  bookingConfirmationMode     BookingConfirmationMode @default(MANUAL_CONFIRM)
  advanceBookingDays          Int                     @default(365)
  minimumBookingNoticeMinutes Int                     @default(0)
  cancellationNoticeMinutes   Int                     @default(0)
  slotIntervalMinutes         Int                     @default(15)
  depositRequired             Boolean                 @default(false)
  depositType                 DepositType             @default(PERCENT)
  depositValue                Int                     @default(30)
  depositBankName             String                  @default("")
  depositAccountNumber        String                  @default("")
  depositAccountHolder        String                  @default("")
  staffHoursMode              StaffHoursMode          @default(CUSTOM)
  pendingExpiryMinutes        Int                     @default(0)
  notificationsEnabled        Boolean                 @default(false)
  listedInDirectory           Boolean                 @default(true)
  autoCompletePast            Boolean                 @default(true)
  reminderMinutes             Int[]                   @default([1440])
  updatedAt                   DateTime                @default(now()) @updatedAt
  salon                       Salon                   @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

// Retail and supply items; quantities are tracked per branch.
model Product {
  id        String         @id @default(cuid())
  salonId   String
  name      String
  sku       String?
  category  String         @default("")
  unit      String         @default("ш")
  costMnt   Int            @default(0)
  priceMnt  Int            @default(0)
  lowStock  Int            @default(0)
  // Optional photo; the list shows the name's first letter without one.
  imageUrl  String?
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  salon     Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  stock     ProductStock[]

  @@unique([id, salonId])
  @@unique([salonId, sku])
  @@index([salonId, active])
}

model ProductStock {
  productId String
  branchId  String
  salonId   String
  quantity  Int     @default(0)
  product   Product @relation(fields: [productId, salonId], references: [id, salonId], onDelete: Cascade)
  branch    Branch  @relation(fields: [branchId, salonId], references: [id, salonId], onDelete: Cascade)

  @@id([productId, branchId])
  @@index([salonId, branchId])
}

// Fixed-window request counters for public endpoints (hashed keys only).
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

enum NotificationEvent {
  BOOKING_RECEIVED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
  BOOKING_REMINDER
}

enum NotificationChannel {
  SMS
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

// Outbox: written with the booking change, delivered after the response.
model Notification {
  id                String              @id @default(cuid())
  salonId           String
  bookingId         String?
  event             NotificationEvent
  channel           NotificationChannel @default(SMS)
  recipient         String
  body              String
  status            NotificationStatus  @default(PENDING)
  attempts          Int                 @default(0)
  lastError         String?
  availableAt       DateTime            @default(now())
  claimedAt         DateTime?
  sentAt            DateTime?
  providerMessageId String?
  dedupeKey         String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  salon             Salon               @relation(fields: [salonId], references: [id], onDelete: Cascade)
  booking           Booking?            @relation(fields: [bookingId, salonId], references: [id, salonId], onDelete: Cascade)

  @@unique([salonId, dedupeKey])
  @@index([status, availableAt])
  @@index([salonId, createdAt])
}

// Append-only record of platform-console actions on salons.
model PlatformAuditLog {
  id          String   @id @default(cuid())
  actorUserId String   @db.Uuid
  action      String
  // NULL once the salon is deleted; salonName keeps who it was.
  salonId     String?
  salonName   String?
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  salon       Salon?   @relation(fields: [salonId], references: [id], onDelete: SetNull)

  @@index([salonId, createdAt])
}

enum BookingActivityType {
  ONLINE_CREATED
  CUSTOMER_CANCELLED
  CUSTOMER_RESCHEDULED
  EXPIRED
}

// Feed for the admin bell, written with the booking change.
model BookingActivity {
  id        String              @id @default(cuid())
  salonId   String
  branchId  String
  bookingId String
  type      BookingActivityType
  createdAt DateTime            @default(now())
  salon     Salon               @relation(fields: [salonId], references: [id], onDelete: Cascade)
  branch    Branch              @relation(fields: [branchId, salonId], references: [id, salonId], onDelete: Cascade)
  booking   Booking             @relation(fields: [bookingId, salonId], references: [id, salonId], onDelete: Cascade)

  @@index([salonId, createdAt])
}

// Photos of the salon's space and work for its public pages.
model SalonImage {
  id        String   @id @default(cuid())
  salonId   String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, sortOrder])
}

// Photos of one branch's space, shown when that branch is picked on the booking page.
model BranchImage {
  id        String   @id @default(cuid())
  salonId   String
  branchId  String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId, salonId], references: [id, salonId], onDelete: Cascade)

  @@unique([id, salonId])
  @@index([branchId, sortOrder])
  @@index([salonId])
}

enum FeedbackKind {
  BUG
  SUGGESTION
  QUESTION
}

enum FeedbackStatus {
  OPEN
  DONE
}

// A salon member's request to the platform operator, with the operator's answer.
model Feedback {
  id        String         @id @default(cuid())
  salonId   String
  userId    String         @db.Uuid
  kind      FeedbackKind
  message   String
  status    FeedbackStatus @default(OPEN)
  reply     String?
  repliedAt DateTime?
  // When the platform operator first opened it; null = unread.
  readAt    DateTime?
  createdAt DateTime       @default(now())
  salon     Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([readAt])
  @@index([salonId, createdAt])
}

// A monthly fee the platform received: recorded by the operator, or paid
// online through Byl (no operator, linked to its checkout).
model SalonPayment {
  id           String           @id @default(cuid())
  salonId      String
  amountMnt    Int
  branches     Int
  periodStart  DateTime
  periodEnd    DateTime
  note         String?
  recordedById String?          @db.Uuid
  createdAt    DateTime         @default(now())
  salon        Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  recordedBy   User?            @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  checkout     BillingCheckout?

  @@index([salonId, createdAt])
  @@index([createdAt])
}

enum CheckoutStatus {
  OPEN
  PAID
  EXPIRED
}

// A Byl payment page opened for one salon's monthly fee. The amount and
// branch count are fixed when it opens; paying it records a SalonPayment.
model BillingCheckout {
  id        String         @id @default(cuid())
  salonId   String
  bylId     Int            @unique
  url       String
  amountMnt Int
  branches  Int
  status    CheckoutStatus @default(OPEN)
  paymentId String?        @unique
  createdAt DateTime       @default(now())
  paidAt    DateTime?
  salon     Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  payment   SalonPayment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([salonId, status, createdAt])
}

// Platform-wide settings; a single row with id "default".
model PlatformSetting {
  id                String   @id @default("default")
  pricePerBranchMnt Int?
  updatedAt         DateTime @updatedAt
}

// How the customer paid at the salon.
enum PaymentMethod {
  POS
  TRANSFER
  CASH
}

enum CancelSource {
  STAFF
  CUSTOMER
  EXPIRED
}

// A guest's rating after a finished visit, left from their private link.
// One per visit, stored on its first booking.
model Review {
  id           String   @id @default(cuid())
  salonId      String
  bookingId    String   @unique
  rating       Int
  comment      String?
  // First name only, as shown publicly.
  customerName String
  hidden       Boolean  @default(false)
  createdAt    DateTime @default(now())
  salon        Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  booking      Booking  @relation(fields: [bookingId, salonId], references: [id, salonId], onDelete: Cascade)

  @@unique([id, salonId])
  @@unique([bookingId, salonId])
  @@index([salonId, createdAt])
}

enum RenewalChoice {
  CONTINUE
  STOP
}

// An announcement from the platform operator to every salon, shown on the
// salon dashboard and, with a verified sender, emailed to each owner.
model PlatformNotice {
  id          String   @id @default(cuid())
  title       String
  message     String
  createdById String   @db.Uuid
  // Owners the email reached; 0 when mail to owners is not set up.
  emailed     Int      @default(0)
  createdAt   DateTime @default(now())
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdAt])
}
