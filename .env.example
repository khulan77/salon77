# Public Supabase Auth configuration. Never use a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"

# Server-only credentials. Use the exact URLs from your Supabase project.
DATABASE_URL="YOUR_POOLED_DATABASE_URL"
DIRECT_URL="YOUR_MIGRATION_DATABASE_URL"

# Server-only Supabase secret key (sb_secret_…) used solely to upload salon images
# to the "salon-media" Storage bucket. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Notifications. SMS_PROVIDER: leave empty to record notices without sending,
# "log" in development to write masked lines to the server log, or "http" for
# a real gateway (also needs the three SMS_* values below). Pages promise SMS
# to customers only with "http" fully configured.
SMS_PROVIDER=
# Gateway endpoint, API key (sent as a Bearer token) and sender name/number.
# The request shape in lib/notifications/provider.ts is a placeholder until a
# gateway is chosen.
SMS_HTTP_URL=
SMS_HTTP_API_KEY=
SMS_SENDER=
# Optional: protects GET /api/cron/notifications (Authorization: Bearer <value>).
CRON_SECRET=
# Optional: signed-out visitors to "/" see the business page until at least
# this many salons are listed in the directory (default 0: always the directory).
DIRECTORY_MIN_SALONS=
# Optional: platform email via Resend (resend.com); see docs/DEPLOYMENT.md 2c.
# Alerts (new salon, new feedback) need the key and PLATFORM_ALERT_EMAIL.
# Mail to owners and invited receptionists also needs RESEND_FROM on a domain
# verified in Resend (never a Gmail address). Replies go to RESEND_REPLY_TO,
# default salon77.mn@gmail.com.
RESEND_API_KEY=
PLATFORM_ALERT_EMAIL=salon77.mn@gmail.com
RESEND_FROM=
RESEND_REPLY_TO=
# Optional: salt for hashed rate-limit keys.
RATE_LIMIT_SALT=
# Public site address, e.g. https://salon77.mn. Enables manage links in messages.
APP_URL=
# Optional overrides for public rate limits (defaults: 8 bookings / 10 min per
# salon, 30 / day, 120 availability lookups / 10 min).
RATE_LIMIT_BOOKINGS=
RATE_LIMIT_BOOKINGS_DAILY=
RATE_LIMIT_AVAILABILITY=

# Optional public social profiles shown in the footer (full https links).
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
# The only emails that may open /platform (comma-separated). Required in
# production; the console also asks for an authenticator-app code.
PLATFORM_ADMIN_EMAILS=salon77.mn@gmail.com
